{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=CourseAcademyStreamingDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Storage": {
    "ServiceUrl": "http://localhost:9000",
    "Region": "us-east-1",
    "AccessKey": "courseacademy",
    "SecretKey": "courseacademy-dev-only",
    "ForcePathStyle": true,
    "RawBucket": "course-raw",
    "HlsBucket": "course-hls",
    "KeysBucket": "course-keys"
  },
  "Webhook": {
    "Url": "http://localhost:5162/api/v1/internal/streaming/webhooks"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
