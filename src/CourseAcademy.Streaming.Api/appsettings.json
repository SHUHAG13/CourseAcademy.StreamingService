{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Auth": {
    "ApiKeys": []
  },
  "Storage": {
    "ServiceUrl": "",
    "Region": "auto",
    "AccessKey": "",
    "SecretKey": "",
    "ForcePathStyle": false,
    "RawBucket": "",
    "HlsBucket": "",
    "KeysBucket": ""
  },
  "Webhook": {
    "Url": "",
    "Secret": "",
    "RetryHours": 24
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/streaming-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
